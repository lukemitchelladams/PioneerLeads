# local secrets
.env
*.key
# downloaded solicitation docs are fine to commit, but not huge binaries over 50MB
# python
__pycache__/
*.pyc
.venv/
# os
.DS_Store
Thumbs.db

# scanner scratch
bids/_watch/raw-*.html
.venv/

# bidwatch: debug dumps (may contain page HTML) and nothing session-related ever in repo
bids/_watch/debug/
bids/_watch/samgov_budget.json

# Actions failover: encrypted BidNet session restored from the cache, never committed
state.enc

# bidwatch session sync (docs/bidwatch.md, "Mac-fed BidNet session"): only the ENCRYPTED .enc may be committed, never a
# decrypted storage state (cookies); ops/session/ holds nothing but .enc files
ops/session/*
!ops/session/*.enc
*.storage-state.json
bidnet-session.json

# pricing and sub quotes stay off the public repo until the bid closes
bids/*/private/
# raw BidNet change pages can carry session fields; keep them out of the public repo until the stripper is fixed (2026-11-18)
bids/_watch/downloads/bidnet/*/_addendum_*.txt

# Luke-signed forms carry his signature: never commit
bids/*/sign/

# agent git worktrees (transient)
.claude/worktrees/
