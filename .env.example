# Copy to .env on YOUR computer only. .env is gitignored. Never commit real values.
BIDNET_USER=luke@brownbisonco.com
BIDNET_PASS=
SAM_API_KEY=
# Optional: path to a Chromium binary if `playwright install chromium` is not used
# BROWNBISON_CHROMIUM=
# Town of Parker (and any other Euna/Bonfire portal) vendor login, for document downloads
BONFIRE_USER=luke@brownbisonco.com
BONFIRE_PASS=
# SAM.gov requests per day cap (1,000/day with an entity role; 10/day without)
# SAM_DAILY_BUDGET=900
# DLA DIBBS may ONLY be read from your own computer/IP (DIBBS FAQ #45 prohibits cloud hosting, VPNs, proxies).
BIDWATCH_ALLOW_DIBBS=1
